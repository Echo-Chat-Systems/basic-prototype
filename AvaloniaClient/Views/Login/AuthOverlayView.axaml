<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaClient.Views.Login.AuthOverlayView"
             xmlns:viewModels="clr-namespace:AvaloniaClient.ViewModels"
             x:DataType="viewModels:Login.AuthOverlayViewModel"
             >

    <Border Background="MidnightBlue" CornerRadius="10">
        <StackPanel Orientation="Vertical">
            <ContentControl Content="{Binding CurrentPage}" />
            <ListBox ItemsSource="{Binding AuthLogs}"></ListBox>
        </StackPanel>


    </Border>
</UserControl>
