<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaClient.Views.Dialog.Login.AuthOverlayView"
             xmlns:login="clr-namespace:AvaloniaClient.ViewModels.Dialog.Login"
             x:DataType="login:AuthOverlayViewModel">

    <StackPanel Orientation="Vertical" Classes="centered">
        <ContentControl Content="{Binding CurrentPage}" />
        <ListBox ItemsSource="{Binding AuthLogs}" IsVisible="False" />
        <TextBlock>Loading...</TextBlock>
        <TextBlock Text="{Binding AuthStage}" />
    </StackPanel>
</UserControl>