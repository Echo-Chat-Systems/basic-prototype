<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:diag="clr-namespace:AvaloniaClient.ViewModels.Dialog"
             x:DataType="diag:NewGuildViewModel"
             x:Class="AvaloniaClient.Views.Dialog.NewGuildView">
    <StackPanel Classes="centered">
        <Label>Create A New Guild</Label>
        <TextBox PlaceholderText="Server Name" Text="{Binding GuildName}" />
        <Button Command="{Binding Submit}">Create!</Button>
    </StackPanel>
</UserControl>
