<Window x:Class="GuiClient.Windows.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:windows="clr-namespace:GuiClient.Windows"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=windows:ClientWindowViewModel, IsDesignTimeCreatable=True}"
        Title="{Binding State.ServerName}">
    <Grid>
        <Label Content="{Binding State.ServerName }" Background="{Binding }"></Label>
    </Grid>
</Window>
